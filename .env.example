# --- Chat / LLM API (OpenAI-compatible) ---
API_BASE_URL=https://api.openai.com/v1
API_KEY=your-api-key-here
CHAT_MODEL=your-model-name

# --- Embedding model + vector database (ChromaDB) ---
EMBEDDING_MODEL=sentence-transformers/multi-qa-MiniLM-L6-dot-v1
CHROMA_PERSIST_DIR=outputs/vector_db
CHROMA_COLLECTION=nbc_v1_multi_qa_minilm_l6_dot_v1

# --- RAG pipeline defaults ---
RAG_CANDIDATE_K=10
RAG_FINAL_K=3
RAG_RERANK_METHOD=cross_encoder

# --- API server binding ---
API_HOST=127.0.0.1
API_PORT=8000
